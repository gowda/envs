<% if result.unassigned_lines.any? %>
  <div class="flash flash-warn mb-3" role="alert">
    <% if result.unassigned_lines.one? %>
      Line <%= result.unassigned_lines.first %> has no =. A container gets no value from this line.
    <% else %>
      Lines <%= result.unassigned_lines.join(", ") %> have no =. A container gets no value from these lines.
    <% end %>
  </div>
<% end %>
<% entries_by_name = result.entries.group_by(&:name) %>
<% repeated_names = entries_by_name.select { |_name, entries| entries.many? } %>
<% if repeated_names.any? %>
  <div class="flash flash-warn mb-3" role="alert" aria-label="Repeated names">
    <% repeated_names.each do |name, entries| %>
      <% choice = local_assigns.fetch(:choices, {})[name] %>
      <% kept = choice&.kept_entry(entries) %>
      <p class="mb-0 variable-text"><%= name %> is on lines <%= entries.map(&:line_number).to_sentence(last_word_connector: " and ") %>. <% if choice %>Line <%= kept.line_number %> stays. A publish removes lines <%= entries.reject { |entry| entry == kept }.map(&:line_number).to_sentence(last_word_connector: " and ") %>.<% else %>Only line <%= entries.last.line_number %> takes effect.<% end %><% if local_assigns[:env_file] && !env_file.deleted_in_s3? %> <%= link_to choice ? "Change" : "Resolve", s3_variable_choice_path(env_file, name: name) %><% end %></p>
    <% end %>
  </div>
<% end %>
<section aria-label="Variables" class="Box">
  <div class="Box-header"><h2 class="Box-title">Variables <span class="Label"><%= result.entries.size %></span></h2></div>
  <% result.entries.each do |entry| %>
    <% choice = local_assigns.fetch(:choices, {})[entry.name] %>
    <% entries = entries_by_name.fetch(entry.name) %>
    <% effective = (choice ? choice.kept_entry(entries) : entries.last) == entry %>
    <% edit = effective ? local_assigns.fetch(:edits, {})[entry.name] : nil %>
    <% value = edit ? edit.value : entry.value %>
    <div class="Box-row d-flex">
      <div class="col-4 pr-3"><span class="text-mono text-bold variable-text"><%= entry.name %></span><% unless effective %> <span class="Label"><%= choice ? "Removed" : "Overridden" %></span><% end %></div>
      <div class="col-8">
        <% if local_assigns[:env_file] && local_assigns.fetch(:value_types, {})[entry.name] == "secret" %><span class="Label">Secret</span><% end %>
        <span class="text-mono variable-text variable-value"><%= value %></span>
        <% if local_assigns.fetch(:conflicts, []).any? { |conflict| conflict.name == entry.name } %><span class="Label Label--danger">Conflict</span><% end %>
        <% if edit %><span class="Label Label--accent">Modified</span><% end %>
        <% if value.match?(/\A[ \t]|[ \t]\z/) %><span class="Label">Leading or trailing whitespace</span><% end %>
        <% if local_assigns[:env_file] && !env_file.deleted_in_s3? && effective %>
          <%= link_to "Edit", edit_s3_variable_path(env_file, name: entry.name), class: "ml-2" %>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
