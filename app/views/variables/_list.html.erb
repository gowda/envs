<section aria-label="Variables" class="Box">
  <div class="Box-header"><h2 class="Box-title">Variables <span class="Label"><%= variables.size %></span></h2></div>
  <% variables.each do |key, value| %>
    <% if value.include?("\n") %>
      <div class="Box-row">
        <div class="text-mono text-bold variable-text mb-2"><%= key %></div>
        <pre class="text-mono variable-text mb-0"><%= value %></pre>
      </div>
    <% else %>
      <div class="Box-row d-flex">
        <div class="col-4 pr-3 text-mono text-bold variable-text"><%= key %></div>
        <div class="col-8 text-mono variable-text"><%= value %></div>
      </div>
    <% end %>
  <% end %>
</section>
