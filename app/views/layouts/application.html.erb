<!DOCTYPE html>
<html data-color-mode="auto" data-light-theme="light" data-dark-theme="dark">
  <head>
    <title><%= content_for(:title) || "envs" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="envs">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "primer", "application" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="Header px-3 px-md-4">
      <span class="Header-item f3 text-bold">envs</span>
      <%= link_to "File upload", files_path, class: "Header-link Header-item", aria: { current: controller_name == "uploads" ? "page" : nil } %>
      <%= link_to "Amazon S3", s3_path, class: "Header-link Header-item", aria: { current: controller_name == "env_files" ? "page" : nil } %>
    </header>
    <main class="container-md p-3 p-md-4">
      <% flash.each do |type, message| %>
        <div class="flash <%= type == "alert" ? "flash-error" : "flash-success" %> mb-3" role="alert"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
