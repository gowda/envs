<!DOCTYPE html>
<html data-color-mode="auto" data-light-theme="light" data-dark-theme="dark">
  <head>
    <title><%= content_for(:title) || "Envs" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Envs">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag "primer", "application" %>
  </head>
  <body>
    <header class="Header px-3 px-md-4">
      <span class="Header-item f3 text-bold">Envs</span>
      <%= link_to "S3 files", root_path, class: "Header-link Header-item" %>
      <%= link_to "Upload", upload_path, class: "Header-link Header-item" %>
    </header>
    <main class="container-md p-3 p-md-4">
      <% flash.each do |type, message| %>
        <div class="flash <%= type == "alert" ? "flash-error" : "flash-success" %> mb-3" role="alert"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
