<% content_for :title, "Edit #{@name} · envs" %>
<div class="Subhead"><h1 class="Subhead-heading">Edit variable</h1></div>
<p class="text-mono variable-text"><%= @env_file.key %></p>
<% if @error %><div class="flash flash-error mb-3" role="alert"><%= @error %></div><% end %>
<% if @conflicted %>
  <div class="flash flash-warn mb-3" role="alert">
    <p>Value when you edited: <span class="text-mono variable-text"><%= @visibility.value(@name, @edit.base_value) %></span></p>
    <p>Value in S3 now: <span class="text-mono variable-text"><%= @visibility.value(@name, @entry.value) %></span></p>
  </div>
<% end %>
<% if @visibility.secret?(@name) %>
  <% if @visibility.revealed?(@name) %>
    <p>Current value: <span class="text-mono variable-text"><%= @entry.value %></span></p>
    <% if @edit %><p>Pending value: <span class="text-mono variable-text"><%= @edit.value %></span></p><% end %>
  <% else %>
    <p>The value is hidden.</p>
  <% end %>
  <%= render "visibility", name: @name, normal_path: edit_s3_variable_path(@env_file, name: @name), reveal_path: reveal_s3_edit_path(@env_file) %>
<% end %>
<%= form_with url: edit_s3_variable_path(@env_file), method: :post, local: true do |form| %>
  <%= form.hidden_field :etag, value: @env_file.etag %>
  <%= form.hidden_field :name, value: @name %>
  <div class="form-group">
    <div class="form-group-header"><%= form.label :value, @name, class: "text-mono variable-text" %></div>
    <div class="form-group-body"><%= form.text_field :value, value: @visibility.secret?(@name) ? "" : @value, class: "form-control input-block text-mono", autocomplete: "off", spellcheck: false %></div>
  </div>
  <%= form.submit "Save", class: "btn btn-primary" %>
  <%= link_to "Cancel", s3_file_path(@env_file), class: "btn" %>
<% end %>
<% if @edit %>
  <%= button_to "Use the S3 value", edit_s3_variable_path(@env_file), method: :delete, params: { name: @name }, class: "btn mt-3" %>
<% end %>
<p class="mt-3">Type: <%= @value_type %></p>
<%= button_to @value_type == "secret" ? "Mark as plain" : "Mark as secret", s3_value_types_path(@env_file),
  params: { name: @name, value_type: @value_type == "secret" ? "plain" : "secret" }, class: "btn" %>
