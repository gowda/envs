<% content_for :title, "File upload · envs" %>
<div data-controller="upload" data-action="dragenter@window->upload#highlight dragover@window->upload#highlight dragleave@window->upload#unhighlight drop@window->upload#drop" class="upload-page">
  <% if @error %>
    <div class="flash flash-error mb-3" role="alert"><%= @error %></div>
  <% end %>
  <%= form_with url: files_path, method: :post, multipart: true, data: { upload_target: "form" }, class: "upload-form" do |form| %>
    <%= form.file_field :file, hidden: true, data: { upload_target: "file", action: "change->upload#submit" }, aria: { label: "Env file" } %>
    <button type="button" class="btn btn-primary" data-action="upload#select">Select an env file</button>
    <p class="color-fg-muted mt-3">Drag an env file anywhere to upload</p>
  <% end %>
</div>
