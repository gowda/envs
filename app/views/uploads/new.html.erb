<% content_for :title, "Upload a dotenv file · Envs" %>
<div class="Subhead">
  <h1 class="Subhead-heading">View dotenv variables</h1>
</div>
<p class="color-fg-muted mb-3">Upload a UTF-8 dotenv file up to 1 MB. Variables are displayed without expanding commands or references.</p>
<% if @error %>
  <div class="flash flash-error mb-3" role="alert"><%= @error %></div>
<% end %>
<%= form_with url: root_path, method: :post, multipart: true, class: "Box p-3 mb-4" do |form| %>
  <div class="form-group mt-0">
    <div class="form-group-header"><%= form.label :file, "Dotenv file" %></div>
    <div class="form-group-body"><%= form.file_field :file, required: true, class: "form-control" %></div>
  </div>
  <%= form.submit "Show variables", class: "btn btn-primary" %>
<% end %>
<% if @variables %>
  <%= render "variables/list", variables: @variables %>
<% end %>
